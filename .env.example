# Runtime secrets are set in Sites Settings, never in browser JavaScript.
# No provider or schedule is enabled by copying this file.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=
# HTTPS JSON supply endpoint with an explicit right to store/use supplied content.
NEWS_FEED_URL=
NEWS_FEED_KEY=
NEWS_MAX_CANDIDATES=40
# Site-scoped IDs supplied by Sites sign-in; bootstrap email can be used for the owner.
ADMIN_USER_IDS=
ADMIN_EMAILS=
JOB_TOKEN=
EVALUATION_APPROVED=false
SCHEDULE_VERIFIED=false
